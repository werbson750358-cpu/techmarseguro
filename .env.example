# Copie para .env ou configure estas variáveis no ambiente.
# Nunca publique uma chave real neste arquivo.
HOST=127.0.0.1
PORT=3000
PAINEL_SENHA=troque-por-uma-senha-com-10-caracteres-ou-mais
COOKIE_SECURE=0

# Opcional: sem AI_API_KEY, o sistema usa regras simples.
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-haiku-5-5
AI_AUTH=x-api-key

# Opcional. Por padrão, os dados ficam na pasta ./data.
# DATA_DIR=./data
